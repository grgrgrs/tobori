---
const { title = "Tobori", gated = false } = Astro.props;
import '../styles/global.css';
import LoggedInStatus from "../components/LoggedInStatus.jsx";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter&display=swap" rel="stylesheet" />
    <meta name="x-default-corpus" content="gr-lens" />
    <style is:global>
      /* Visible, consistent links in all rendered brief HTML */
      .brief-html a {
        color: #0645ad !important;              /* force dark blue */
        text-decoration: underline !important;  /* visible without hover */
        text-underline-offset: 2px;
      }
      .brief-html a:hover { text-decoration-thickness: 2px; }
      .brief-html a:focus  { outline: 2px solid #0645ad; outline-offset: 2px; }
      .brief-html a:visited { color: #5a32a3; }

      @media print {
        .brief-html a { color: #000 !important; }
        .brief-html a::after { content: " (" attr(href) ")"; font-size: 90%; }
      }
    </style>

  <script is:inline>
    // global auth state
    window.__me = null;

    async function refreshAuth() {
      try {
        const r = await fetch("/api/me", { credentials: "include" });
        window.__me = r.ok ? await r.json() : null;
      } catch { window.__me = null; }
      // let everyone know
      window.dispatchEvent(new CustomEvent("auth-state", { detail: window.__me }));
    }
    // run once on load
    refreshAuth();
    </script>

  </head>
  
  <body style="max-width: 1100px; margin: auto; padding: 0 1rem; font-family: 'Inter', sans-serif; box-sizing: border-box;">

    <!-- 🔐 Gate: only when a page passes gated={true} -->
    {gated && (
        <>
          <script is:inline>
            (async () => {
              let r;
              try { r = await fetch('/api/corpora', { credentials: 'include' }); } catch {}
              if (!r || !r.ok) {
                const next = encodeURIComponent(location.pathname + location.search);
                location.assign('/login?next=' + next);
              }
            })();
          </script>

          <script is:inline>
            (function () {
              const _fetch = window.fetch;
              function shouldSkip(u) {
                try {
                  const url = typeof u === 'string' ? new URL(u, location.origin) : u;
                  return url.pathname.startsWith('/api/signup') ||
                         url.pathname.startsWith('/api/logout') ||
                         url.pathname === '/api/corpora';
                } catch { return true; }
              }
              window.fetch = function (input, init) {
                init = init || {};
                if (!('credentials' in init)) init.credentials = 'include';
                try {
                  if (!shouldSkip(input)) {
                    const url = typeof input === 'string' ? new URL(input, location.origin) : new URL(input.url);
                    const cid = localStorage.getItem('selectedCorpusId') || '';
                    if (cid && !url.searchParams.has('corpus_id')) {
                      url.searchParams.set('corpus_id', cid);
                    }
                    input = (typeof input === 'string') ? url.toString() : new Request(url.toString(), input);
                  }
                } catch {}
                return _fetch(input, init);
              };
            })();
          </script>
        </>
      )}

    <header
      style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1.1rem;
        border-bottom: 1px solid #ddd;
        flex-wrap: wrap; /* allow wrapping on small screens */
      "
    >
      <!-- Left: Site title -->
      <h1 style="font-size: 1.8rem; font-weight: 400; margin: 0;">
        Tobori 
      </h1>

      <!-- Right: Nav links + login status -->
      <nav
        style="
          display: flex;
          align-items: center;
          gap: 1.25rem;
          font-size: 1rem;
          flex-wrap: wrap;          /* allow wrapping */
          justify-content: flex-end; /* right-align items */
          margin-top: 0.25rem;       /* slight spacing if wrapped */
        "
      >
        <a href="/" data-keep-corpus style="text-decoration: none; color: #333;">Home</a>
        <a href="/articles" data-keep-corpus style="text-decoration: none; color: #333;">Articles</a>
        <a href="/reports" data-keep-corpus style="text-decoration: none; color: #333;">Briefs</a>
        <a href="/blog" style="text-decoration: none; color: #333;">Blog</a>
        <a href="/faq" style="text-decoration: none; color: #333;">FAQ</a>
        <a href="/connect" style="text-decoration: none; color: #333;">Connect</a>
        <LoggedInStatus client:only="react" />
      </nav>

      <script is:inline>
        (function () {
          const LS = "tobori.corpus_slug";

          function getSlug() {
            const sp = new URLSearchParams(location.search);
            const s = sp.get("corpus");
            if (s) { try { localStorage.setItem(LS, s); } catch {} }
            if (s) return s;
            try { return localStorage.getItem(LS) || ""; } catch { return ""; }
          }

          function withCorpus(href, slug) {
            try {
              const u = new URL(href, location.origin);
              if (slug) { u.searchParams.set("corpus", slug); u.searchParams.delete("corpus_id"); }
              return u.pathname + (u.search ? u.search : "");
            } catch { return href; }
          }

          function updateNav(slug) {
            const sel = [
              'header nav a[href="/"]',
              'header nav a[href="/home"]',
              'header nav a[href="/articles"]',
              'header nav a[href="/reports"]',
              'header nav a[href="/briefs"]',
              'header nav a[href="/blog"]',
              'header nav a[href="/faq"]',
              'header nav a[href="/connect"]'
            ].join(',');
            document.querySelectorAll(sel).forEach(a => {
              a.setAttribute("href", withCorpus(a.getAttribute("href"), slug));
            });
          }

          // initial rewrite
          updateNav(getSlug());

          // keep in sync when any page changes corpus
          window.addEventListener("corpus:changed", (e) => {
            const s = e?.detail?.slug || getSlug();
            if (!s) return;
            try { localStorage.setItem(LS, s); } catch {}
            updateNav(s);
          });
        })();
      </script>

      
    </header>



    <main>
      <slot />
    </main>
    <footer style="margin-top: 3rem; font-size: 0.8rem;">
      © George Rogers · Built with Astro
    </footer>
      <script is:inline>
    (() => {
      const LS = 'tobori.corpus_slug';
      const currentSlug = () =>
        new URLSearchParams(location.search).get('corpus') ||
        (localStorage.getItem(LS) || '');

      const withCorpus = (href, slug) => {
        const u = new URL(href, location.href);
        // don't touch cross-origin or public /r/* links
        if (u.origin !== location.origin) return href;
        if (u.pathname.startsWith('/r/')) return href;
        if (slug) u.searchParams.set('corpus', slug);
        else u.searchParams.delete('corpus');
        return u.toString();
      };

      // Rewrite all marked links to the latest slug
      const rewriteAll = () => {
        const slug = currentSlug();
        document.querySelectorAll('a[data-keep-corpus]').forEach(a => {
          const raw = a.getAttribute('href') || a.href; // keep original intent
          a.href = withCorpus(raw, slug);
        });
      };

      // Initial pass & react to in-app corpus changes
      rewriteAll();
      window.addEventListener('corpus:changed', rewriteAll);

      // Safety net: on click, force the corpus into the target URL
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-keep-corpus]');
        if (!a) return;
        const target = withCorpus(a.getAttribute('href') || a.href, currentSlug());
        if (target !== a.href) {
          e.preventDefault();
          location.href = target;
        }
      });
    })();
  </script>
  </body>
</html>
