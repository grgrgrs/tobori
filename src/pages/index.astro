---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../styles/daily-summary.css';
import RecentBlogTeaser from '../components/RecentBlogTeaser.astro';
import AppShell from '../components/AppShell.jsx';

// Blog collection is still static at build time
const posts = await getCollection('blog');
const latestPost = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate))[0];
const { Content } = await latestPost.render();

// Load daily summary HTML from /public/daily_summary.html
const summaryPath = path.resolve(process.cwd(), 'public', 'daily_summary.html');
let dailySummary = '';
try {
  dailySummary = fs.readFileSync(summaryPath, 'utf-8').trim();
} catch (err) {
  dailySummary = '';
}

const DEFAULT_CORPUS = "gr-lens";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Tobori</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- Avoid flash while we decide -->

  <meta name="x-default-corpus" content={DEFAULT_CORPUS} />
  <script is:inline>
    (async () => {
      try {
        const qp = new URLSearchParams(location.search);
        const fromUrl = qp.get("corpus_id");
        const res = await fetch("/api/me", { credentials: "include" });
        if (res.ok) {
          const meta = document.querySelector('meta[name="x-default-corpus"]');
          const defaultCorpus = meta ? meta.content : "gr-lens";
          const fromStorage = localStorage.getItem("preferred_corpus");
          const corpus = fromUrl || fromStorage || defaultCorpus;
          const target = new URL("/home", location.origin);
          if (corpus) target.searchParams.set("corpus_id", corpus);
          location.replace(target.toString());
          return;
        }
      } catch {}
      document.documentElement.style.opacity = "1"; // show marketing when not authed
    })();
  </script>
    
  </head>
  <body>
    <!-- Signed-out marketing landing lives here -->
    <main>
      <section class="hero">
        <h1>Tobori</h1>
        <p>AI-curated briefs from the sources you trust.</p>
        <a href="/login" class="btn">Log in / Get started</a>
      </section>
      <!-- Features / screenshots / FAQs… -->
    </main>
    <noscript>
      <p><a href="/login">Log in</a></p>
    </noscript>
  </body>
</html>