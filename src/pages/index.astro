---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../styles/daily-summary.css';
import RecentBlogTeaser from '../components/RecentBlogTeaser.astro';


// Blog collection is still static at build time
const posts = await getCollection('blog');
const latestPost = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate))[0];
const { Content } = await latestPost.render();

// Load daily summary HTML from /public/daily_summary.html
const summaryPath = path.resolve(process.cwd(), 'public', 'daily_summary.html');
let dailySummary = '';
try {
  dailySummary = fs.readFileSync(summaryPath, 'utf-8').trim();
} catch (err) {
  dailySummary = '';
}
---

<BaseLayout title="Home">

  <section style="margin-top: 3rem;">
    <section style="text-align:center; margin: 2rem 0;">
      <img 
        src="/images/midj-tobori-hero-woman.png" 
        alt="AI news filtering into highlights" 
        style="max-width: 800px; width: 100%; height: auto; border-radius: 8px;"
      />
    </section>

    <p style="max-width: 800px; margin: 1rem auto 0 auto; font-size: 20px; font-weight: normal; line-height: 1.5;">
      Daily‑scored AI news, focused on my research interests. Here are today’s highlights. 
      See more on the <a href="/articles" style="color: #0066cc;">Articles</a> page.
    </p>

    <!-- New Daily Summary Section (via DB deploy) -->
    <section id="daily-brief" style="max-width:800px; margin:2rem auto; display:none;">
      <div id="daily-brief-title" style="font-weight:600;margin-bottom:.5rem;"></div>
      <div class="daily-summary"></div>
    </section>

    <script is:inline>
    (async () => {
      try {
        const r = await fetch('/api/daily-brief'); // latest row
        if (!r.ok) return;
        const data = await r.json();
        const wrap = document.getElementById('daily-brief');
        const body = document.querySelector('#daily-brief .daily-summary');
        const title = document.getElementById('daily-brief-title');
        if (data?.summary_html && wrap && body) {
          title.textContent = data.title ? `${data.title} — ${data.date}` : (data.date || '');
          body.innerHTML = data.summary_html; // safe: you control the content
          wrap.style.display = '';
        }
      } catch (err) {
        console.warn('daily-brief fetch failed', err);
      }
    })();
    </script>
    <RecentBlogTeaser />

  </section>

  <hr style="margin: 2rem 0;" />



</BaseLayout>
