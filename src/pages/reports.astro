---
import ReportsPage from "../components/ReportsPage.jsx";

// Optional: if you have a server endpoint for corpora, you can fetch and pass options:
// const res = await fetch(import.meta.env.PUBLIC_API_BASE + "/api/corpora", { headers: { cookie: Astro.request.headers.get('cookie') || '' } });
// const corpusOptions = res.ok ? await res.json() : undefined;

// MVP: skip options; the component will fall back to a free-text input for corpus.
const corpusOptions = undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Reports</title>
  </head>
  <body class="min-h-screen">
    <main class="mx-auto max-w-6xl p-4">
      <ReportsPage client:load corpusOptions={corpusOptions} />
    </main>
  </body>
</html>
